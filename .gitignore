# ============================================
# System files
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ============================================
# Claude Context Files
# ============================================
# Root .claude/ directory (injected by devcontainer, user-specific)
/.claude/*
# Exception: project-specific commands are committed
!/.claude/commands/
# Exception: feature tracking database (RTM) is committed
!/.claude/features.json
# CLAUDE.md files are now ALL committed (funnel documentation structure)

# ============================================
# Claude Logs (Context Recovery System)
# ============================================
# Logs are local to each developer, never committed
/.claude/logs/
**/.shipper_offset
**/checkpoint.json.tmp.*

# ============================================
# Search Context Files (generated by /search)
# ============================================
.claude/contexts/

# ============================================
# Environment & Secrets (CRITICAL)
# ============================================
.env
.env.local
.env.*.local
**/.env
/mcp.json

# VPN configs and credentials (never commit)
*.ovpn
*.wgconf
ipsec.secrets
**/vpn-auth.txt

