# ============================================

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv/

# Go
vendor/
*.exe
*.test
*.out

# Rust
target/
Cargo.lock

# Java
*.class
*.jar
*.war
.gradle/
build/

# Ruby
*.gem
.bundle/
vendor/bundle/

# PHP
vendor/
composer.lock

# .NET
bin/
obj/
*.dll
*.exe

# ============================================
# IDE & Editor files
# ============================================
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ============================================
# Build & Output directories
# ============================================
dist/
out/
*.log


# ============================================
# DevContainer internal files (generated)
# ============================================
.devcontainer/docs/
.devcontainer/.template-version
.devcontainer/claude-assets.tar.gz
.devcontainer/devcontainer-lock.json

# ============================================
# Ignore vscode AI rules
# ============================================
.github/instructions/codacy.instructions.md
.codacy/
# Agent-managed planning scratchpad — but NOT test fixtures that happen to live
# under a directory named "plans/" (e.g. tests/fixtures/refine/plans/*.md).
# Anchor the ignore to the agent locations so fixtures stay tracked.
.claude/plans/
.devcontainer/images/.claude/plans/
# Defensive: ignore legacy .grepai/ artifacts (removed 2026-04, cleanup_legacy_grepai
# in postStart.sh deletes them on start, but keep ignored for safety during the
# migration transition).
.grepai/

# ============================================
# 3GPP corpus & RAG artifacts (NEVER committed — see docs/data-pipeline.md)
# Raw sources (~37GB) + converted HTML (~37GB) -> mirrored to ghcr.io.
# Index 3gpp.duckdb (~1.7GB) -> shipped via GitHub Releases.
# Models (~2.3GB) -> fetched from HuggingFace.
# Only corpus.lock (the manifest) is git-tracked.
# ============================================
/data/
*.duckdb
*.duckdb.wal
*.kuzu/
*.zst
# Keep the manifest tracked even though it ends in .lock
!corpus.lock

# ktn-linter cache (generated at runtime)
*.ktn-linter.cache.db

# RTK token savings tracking (local per-developer)
.rtk/

# ============================================
# Claude Code session logs (context recovery)
# ============================================
.claude/logs/
core.*
.taskmaster/
docs/architecture-pipeline.md

# Root-level Go build artifacts: `go build ./cmd/<name>` with no -o drops the
# binary at the repo root. Ignore every cmd binary name so a stray build never
# gets committed (the real outputs go to bin/ or dist/ via the Makefile).
/bench
/discover
/ingest
/ingest-catalog
/ingest-openapi
/li-audit
/merge
/server
